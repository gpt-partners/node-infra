# Sample for /etc/node-infra/backup.env on the node (mode 0600). Keep it out of git.
# Read by node-infra-backup.service and node-infra-backup-check.service.

# Backblaze B2 through its S3-compatible API (recommended by restic). Endpoint from the bucket
# details page; the path after the bucket name is the restic repository inside it.
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/example-bucket/wake-u

# Encrypts the backups. Store a copy outside the node (password manager): without it the
# backups cannot be read.
RESTIC_PASSWORD=change-me

# B2 application key limited to this bucket, with read and write access (keyID / applicationKey).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
