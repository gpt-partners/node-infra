# {{ ansible_managed }}
# Routes the wg-easy web UI (Docker on the host, outside the cluster) through Traefik with a
# Let's Encrypt certificate, reachable only through the VPN.
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
spec:
  acme:
    email: {{ node_acme_email }}
    server: https://acme-v02.api.letsencrypt.org/directory
    privateKeySecretRef:
      name: letsencrypt-prod
    solvers:
      # The solver ingress has no middleware, so HTTP-01 works from the internet.
      - http01:
          ingress:
            ingressClassName: traefik
---
apiVersion: v1
kind: Namespace
metadata:
  name: wg-easy
---
apiVersion: v1
kind: Service
metadata:
  name: wg-easy
  namespace: wg-easy
spec:
  ports:
    - name: http
      port: 51821
      targetPort: 51821
      protocol: TCP
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: wg-easy-host
  namespace: wg-easy
  labels:
    kubernetes.io/service-name: wg-easy
addressType: IPv4
endpoints:
  - addresses:
      - {{ node_vpn_bridge_ipv4 }}
ports:
  - name: http
    port: 51821
    protocol: TCP
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: vpn-only
  namespace: wg-easy
spec:
  ipAllowList:
    sourceRange:
      - {{ vpn_ui_allowed_source }}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: wg-easy
  namespace: wg-easy
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
    traefik.ingress.kubernetes.io/router.middlewares: wg-easy-vpn-only@kubernetescrd
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - {{ node_vpn_ui_host }}
      secretName: wg-easy-tls
  rules:
    - host: {{ node_vpn_ui_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: wg-easy
                port:
                  number: 51821
