# {{ ansible_managed }}
# First install of Argo CD only (k3s helm-controller). The role hands the chart over right after
# Argo CD is ready; its settings live in platform/argocd.yaml in the platform repository.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: argocd
  namespace: kube-system
spec:
  repo: https://argoproj.github.io/argo-helm
  chart: argo-cd
  version: {{ argocd_bootstrap_chart_version }}
  targetNamespace: argocd
  createNamespace: true
