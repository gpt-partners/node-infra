# {{ ansible_managed }}
[Unit]
Description=Back up the node with restic
Wants=network-online.target
After=network-online.target
ConditionPathExists={{ backup_env_file }}

[Service]
Type=oneshot
# RESTIC_REPOSITORY, RESTIC_PASSWORD, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
EnvironmentFile={{ backup_env_file }}
Environment=RESTIC_CACHE_DIR=/var/cache/restic
CacheDirectory=restic
ExecStart=/usr/local/sbin/node-infra-backup
Nice=10
IOSchedulingClass=idle
