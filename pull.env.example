# Sample for /etc/node-infra/pull.env on the node. Copy it there, fill in the real values, keep it out of git.
# Read by node-infra-pull.service (systemd EnvironmentFile: KEY=value, no quotes, no spaces around =).
# The addresses below are placeholders.

# Repository that ansible-pull fetches. HTTPS works without a key while the repo is public.
NODE_INFRA_REPO_URL=https://github.com/gpt-partners/server.git

# Branch that is applied. Only main.
NODE_INFRA_BRANCH=main

# wg-easy Docker bridge. The host gets the first address of the IPv4 subnet (NODE_INFRA_VPN_BRIDGE_IPV4);
# the wg-easy UI and dnsmasq listen only there. Changing these on a running node recreates the network.
NODE_INFRA_VPN_SUBNET_IPV4=10.99.0.0/24
NODE_INFRA_VPN_SUBNET_IPV6=fd00:99::/64
NODE_INFRA_VPN_BRIDGE_IPV4=10.99.0.1
NODE_INFRA_WG_EASY_IPV4=10.99.0.42
NODE_INFRA_WG_EASY_IPV6=fd00:99::2a

# Split DNS for VPN clients, comma-separated without spaces. These names and all their subdomains resolve to the
# bridge address; everything else goes to the upstream resolvers.
NODE_INFRA_DNS_VPN_DOMAINS=vpn.example.com,preview.example.com
NODE_INFRA_DNS_UPSTREAMS=1.1.1.1,9.9.9.9

# Argo CD follows main of the private platform repository (gpt-partners/platform) over SSH with a read-only deploy key.
# The key file is created by hand on the node (mode 0600) and never leaves it.
NODE_INFRA_ARGOCD_REPO_URL=git@github.com:example-org/platform.git
NODE_INFRA_ARGOCD_DEPLOY_KEY_FILE=/etc/node-infra/argocd-deploy-key
